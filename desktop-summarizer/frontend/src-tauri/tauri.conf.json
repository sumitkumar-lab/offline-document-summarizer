{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Offline Document Summarizer",
  "version": "0.4.0",
  "identifier": "com.local.offlinedocumentsummarizer",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Offline Document Summarizer",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8765 http://localhost:8765 https://api.github.com; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "externalBin": ["../../backend-dist/offline-summarizer-backend"]
  }
}
